<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inventoryScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inventory"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#1F4E79"
            android:layout_marginBottom="20dp" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="*"
            android:background="#FFFFFF">

            <TableRow>
                <TextView android:text="Item" android:textStyle="bold" android:padding="8dp" />
                <TextView android:text="Qty" android:textStyle="bold" android:padding="8dp" />
                <TextView android:text="Location" android:textStyle="bold" android:padding="8dp" />
                <TextView android:text="Action" android:textStyle="bold" android:padding="8dp" />
            </TableRow>

            <TableRow>
                <TextView android:text="Gloves" android:padding="8dp" />
                <TextView android:text="12" android:padding="8dp" />
                <TextView android:text="Aisle 1" android:padding="8dp" />
                <Button android:text="Delete" />
            </TableRow>

            <TableRow>
                <TextView android:text="Boxes" android:padding="8dp" />
                <TextView android:text="4" android:padding="8dp" />
                <TextView android:text="Stockroom" android:padding="8dp" />
                <Button android:text="Delete" />
            </TableRow>

        </TableLayout>

        <Button
            android:id="@+id/buttonAddItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Item"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/buttonEditItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Selected Item"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/buttonSms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMS Notification Settings"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/buttonLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>